# Copie este arquivo para ".env" e preencha com os dados reais.

# String de conexão do Supabase (Settings > Database > Connection string > URI).
# DIRECT_URL é a mesma conexão direta (porta 5432) — sempre necessária pra
# rodar migrations, mesmo se DATABASE_URL for trocada pro pooler (porta 6543).
DATABASE_URL=""
DIRECT_URL=""

# Chave secreta para assinar os tokens de login (JWT). Gere uma aleatória, ex:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="troque-por-uma-string-aleatoria-gerada-por-voce"

# URL do projeto Supabase (Project Settings > API > Project URL)
SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"

# Chave service_role (Project Settings > API > Project API keys > service_role).
# NUNCA expor no client — só usada no servidor pra enviar imagens ao Storage.
SUPABASE_SERVICE_ROLE_KEY="sua-service-role-key-aqui"

# Credenciais do OAuth do Google (console.cloud.google.com > APIs & Services >
# Credentials > OAuth client ID > Web application). Usado só no "Entrar com
# Google" do cliente.
GOOGLE_CLIENT_ID="seu-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="seu-client-secret-aqui"

# Envio de e-mail (convite de barbeiro + boas-vindas) via Gmail/SMTP.
# GMAIL_USER: o endereço Gmail que vai aparecer como remetente.
# GMAIL_APP_PASSWORD: NÃO é a senha normal da conta — é uma "senha de app"
# de 16 letras. Pra gerar: ative a verificação em duas etapas em
# myaccount.google.com/security, depois vá em
# myaccount.google.com/apppasswords e crie uma senha de app pra "Mail".
GMAIL_USER="seu-email@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"
