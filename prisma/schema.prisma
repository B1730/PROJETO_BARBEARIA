// Schema do banco de dados - PostgreSQL (Supabase free tier)
// Estratégia multi-tenant: um banco só, isolado por barbeariaId em cada tabela.
// Isso é mais barato e simples de manter do que um banco por barbearia,
// e na prática funciona igual: cada barbearia só enxerga seus próprios dados.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Usado só pelo `prisma migrate`/`db push` — precisa de uma conexão
  // direta (não pooler) porque DDL não roda bem via pgbouncer em modo
  // transação. Quando DATABASE_URL apontar pro pooler do Supabase (porta
  // 6543, ver "Ambiente" no CLAUDE.md), DIRECT_URL continua apontando pra
  // conexão direta (porta 5432) que já existia antes.
  directUrl = env("DIRECT_URL")
}

enum PapelUsuario {
  CLIENTE
  BARBEIRO
  DONO
  // Equipe da própria plataforma (não pertence a nenhuma barbearia, igual
  // CLIENTE nesse sentido) — nunca nasce por rota pública (nenhum schema de
  // cadastro/Google aceita esse valor, ver regra de negócio 7). Só existe
  // criado manualmente (scripts/criar-admin-plataforma.ts). Acesso a uma
  // barbearia específica é sempre concedido pelo DONO, temporário e
  // somente leitura — ver model AcessoPlataforma e regra de negócio 14.
  ADMIN
}

enum StatusAgendamento {
  PENDENTE
  CONFIRMADO
  RECUSADO
  CANCELADO
  CONCLUIDO
}

// A "barbearia" é o tenant. Tudo que pertence a ela carrega barbeariaId.
model Barbearia {
  id            String   @id @default(cuid())
  nome          String
  slug          String   @unique // usado na URL: barbearia.com/minha-barbearia
  telefone      String?
  endereco      String?
  criadoEm      DateTime @default(now())

  usuarios      Usuario[]
  servicos      Servico[]
  agendamentos  Agendamento[]
  acessosAdmin  AcessoPlataforma[]
}

// Um único model de usuário para os 3 papéis (cliente, barbeiro, dono).
// Simplifica autenticação: um só fluxo de login pra todo mundo.
model Usuario {
  id            String        @id @default(cuid())
  nome          String
  email         String        @unique
  // Opcional porque conta criada via "Entrar com Google" não tem senha —
  // ver src/app/api/auth/google/callback/route.ts. Login por e-mail/senha
  // sempre checa se isso está preenchido antes de comparar.
  senhaHash     String?
  telefone      String?
  papel         PapelUsuario
  criadoEm      DateTime      @default(now())

  // whatsapp é usado por qualquer papel: BARBEIRO/DONO(atendeComoBarbeiro)
  // pra notificação de novo agendamento via CallMeBot (ver
  // src/lib/whatsapp.ts, callmebotApiKey é a chave pessoal que o CallMeBot
  // devolve depois que a pessoa ativa o próprio número — não dá pra gerar
  // isso do nosso lado); e CLIENTE só guarda o número em si (sem
  // callmebotApiKey, cliente não recebe notificação automática), pra o
  // barbeiro poder entrar em contato se precisar (ver GET /api/agendamentos,
  // que inclui isso no `cliente` pra quem já pode ver aquele agendamento).
  whatsapp        String?
  callmebotApiKey String?

  // Só faz sentido quando papel = BARBEIRO. "Um chefe só por barbearia":
  // o dono promove/rebaixa (ver POST /api/barbeiros/[id]), que garante
  // essa regra rebaixando qualquer chefe atual antes de promover outro.
  // O chefe enxerga agenda/faturamento de todos os barbeiros da mesma
  // barbearia (ver src/lib/exigirSessao.ts, sessaoTemPrivilegioDeChefe).
  ehChefe         Boolean  @default(false)

  // Só faz sentido quando papel = DONO — liga/desliga por conta própria em
  // PATCH /api/perfil (ver "Meu perfil" em admin/page.tsx). Quando true, o
  // dono passa a aparecer como um barbeiro de verdade pro cliente (mesmo
  // tratamento que um BARBEIRO em todo lugar que hoje só olha
  // `papel === "BARBEIRO"` — ver sessaoAtendeComoBarbeiro() em
  // src/lib/exigirSessao.ts): pode cadastrar a própria Disponibilidade,
  // aparece no fluxo de agendamento do cliente, e confirma/recusa os
  // próprios agendamentos igual qualquer barbeiro.
  atendeComoBarbeiro Boolean @default(false)

  // Foto de perfil (só barbeiro usa isso na interface, mas o campo fica
  // disponível pra qualquer usuário). Guardada no Supabase Storage — este
  // campo é só a URL pública, não o arquivo.
  fotoUrl       String?

  // Barbeiros e donos pertencem a uma barbearia. Clientes podem agendar em
  // qualquer barbearia, então barbeariaId fica nulo para eles.
  // onDelete Restrict (igual Servico/Agendamento) — sem isso, apagar uma
  // Barbearia deixaria barbeiro/dono órfãos com barbeariaId nulo, o que
  // contradiz a regra "barbeiros e donos têm barbeariaId preenchido".
  barbeariaId   String?
  barbearia     Barbearia?    @relation(fields: [barbeariaId], references: [id], onDelete: Restrict)

  // Relações específicas de barbeiro
  disponibilidades   Disponibilidade[]
  agendamentosComoBarbeiro Agendamento[] @relation("AgendamentosDoBarbeiro")
  servicosQueRealiza  ServicoBarbeiro[]

  // Relações específicas de cliente
  agendamentosComoCliente  Agendamento[] @relation("AgendamentosDoCliente")

  // Só faz sentido quando papel = ADMIN — os acessos temporários que esse
  // administrador da plataforma já recebeu de algum DONO (ver
  // AcessoPlataforma, regra de negócio 14).
  acessosComoAdmin AcessoPlataforma[] @relation("AcessosComoAdmin")

  @@index([barbeariaId])
}

// Corte/serviço oferecido pela barbearia (nome e duração são da barbearia,
// mas o preço final pode variar por barbeiro via ServicoBarbeiro).
model Servico {
  id            String   @id @default(cuid())
  barbeariaId   String
  barbearia     Barbearia @relation(fields: [barbeariaId], references: [id])
  nome          String   // ex: "Corte degradê"
  duracaoMinutos Int     @default(30)
  precoBase     Decimal  @db.Decimal(10, 2)
  ativo         Boolean  @default(true)
  // URL pública da foto no Supabase Storage (bucket "cortes"), opcional.
  imagemUrl     String?
  // Default true: corte criado por quem tem privilégio de chefe (DONO ou
  // barbeiro-chefe, ver sessaoTemPrivilegioDeChefe) já nasce aprovado. Só
  // fica false quando um BARBEIRO contratado comum cria um corte novo —
  // vira uma solicitação pendente (regra de negócio 5) até o chefe aprovar
  // via PATCH /api/servicos/[id] com {aprovado:true}. Corte só aparece pro
  // cliente quando ativo E aprovado (ver src/lib/barbearia.ts).
  aprovado      Boolean  @default(true)

  barbeiros     ServicoBarbeiro[]
  agendamentos  AgendamentoServico[]

  @@index([barbeariaId])
}

// Tabela de ligação: quais barbeiros fazem qual serviço, e por qual preço
// (permite cada barbeiro ter um preço próprio pro mesmo corte, se quiser).
// Desde a regra de negócio 5 (revisada): todo corte precisa de vínculo
// explícito — não existe mais "lista vazia = barbearia toda atende".
model ServicoBarbeiro {
  id          String   @id @default(cuid())
  servicoId   String
  servico     Servico  @relation(fields: [servicoId], references: [id])
  barbeiroId  String
  barbeiro    Usuario  @relation(fields: [barbeiroId], references: [id])
  preco       Decimal  @db.Decimal(10, 2)

  @@unique([servicoId, barbeiroId])
}

// Janela de disponibilidade que o barbeiro cadastra (ex: toda segunda 9h-18h).
// Os horários "livres" mostrados ao cliente são calculados a partir daqui,
// subtraindo os agendamentos já confirmados/pendentes.
model Disponibilidade {
  id            String   @id @default(cuid())
  barbeiroId    String
  barbeiro      Usuario  @relation(fields: [barbeiroId], references: [id])
  diaDaSemana   Int      // 0 = domingo ... 6 = sábado
  horaInicio    String   // "09:00"
  horaFim       String   // "18:00"

  // Sem índice solto em barbeiroId: a constraint abaixo já cobre buscas só
  // por barbeiroId via prefixo esquerdo (mesmo padrão usado em Agendamento,
  // ver @@unique([barbeiroId, data]) — um índice avulso ali seria redundante).
  // Trava contra cadastrar a mesma janela duas vezes (mesmo dia da semana
  // com o mesmo início/fim) — não bloqueia janelas diferentes no mesmo
  // dia, só a exatamente igual.
  @@unique([barbeiroId, diaDaSemana, horaInicio, horaFim])
}

model Agendamento {
  id            String            @id @default(cuid())
  barbeariaId   String
  barbearia     Barbearia         @relation(fields: [barbeariaId], references: [id])

  clienteId     String
  cliente       Usuario           @relation("AgendamentosDoCliente", fields: [clienteId], references: [id])

  barbeiroId    String
  barbeiro      Usuario           @relation("AgendamentosDoBarbeiro", fields: [barbeiroId], references: [id])

  // Um agendamento pode ter mais de um corte (ex.: cabelo + barba) — ver
  // AgendamentoServico. precoCobrado/duracaoMinutos abaixo já são a SOMA
  // de todos os cortes escolhidos, congelada no momento da criação; é
  // assim que calcularHorariosLivres() (src/lib/horarios.ts),
  // /api/financeiro e o relatório de desempenho continuam funcionando sem
  // precisar saber quantos cortes tem cada agendamento — só somam esses
  // dois campos, igual antes.
  servicos      AgendamentoServico[]

  data          DateTime          // data e hora de início do agendamento
  precoCobrado  Decimal           @db.Decimal(10, 2) // "congela" a soma dos preços no momento do agendamento
  // "Congela" a soma das durações dos cortes escolhidos, igual
  // precoCobrado — sem isso, mudar duracaoMinutos de um Servico depois que
  // já existem agendamentos muda retroativamente o cálculo de conflito de
  // horário deles (ver src/lib/horarios.ts). Nullable só pra não exigir
  // backfill dos agendamentos criados antes desse campo existir.
  duracaoMinutos Int?
  status        StatusAgendamento @default(PENDENTE)

  // Só o próprio barbeiro (dono desse agendamento) pode marcar isso, e só
  // quando status é CONCLUIDO/CANCELADO (ver PATCH /api/agendamentos/[id]).
  // Não apaga nada — só some da listagem padrão dele (GET /api/agendamentos
  // filtra por isso por padrão; ?mostrarOcultos=1 desfaz o filtro, pra dar
  // um jeito de reverter). Cliente e outros barbeiros nunca são afetados —
  // é só a visão de quem ocultou.
  ocultoPeloBarbeiro Boolean @default(false)

  // Pedido de cancelamento feito pelo CLIENTE (ver POST
  // /api/agendamentos/[id]/cancelar) — não muda o status sozinho: o
  // agendamento continua PENDENTE/CONFIRMADO (e continua ocupando o
  // horário normalmente, ver calcularHorariosLivres) até o barbeiro
  // decidir. cancelamentoSolicitadoEm nulo = nenhum pedido em aberto.
  // O barbeiro então confirma (status vira CANCELADO, ver
  // TRANSICOES_PERMITIDAS) ou mantém o agendamento (os dois campos voltam
  // a nulo, sem mudar o status) depois de conversar com o cliente.
  cancelamentoSolicitadoEm DateTime?
  motivoCancelamento       String?

  // Marcado uma única vez, no exato momento em que o status vira
  // CONFIRMADO (PATCH /api/agendamentos/[id]) — nunca mais muda depois
  // disso, mesmo que o agendamento avance pra CONCLUIDO/CANCELADO depois.
  // Existe só pro relatório de desempenho do chefe (tempo de demora pra
  // aceitar, ver GET /api/relatorio-equipe): `atualizadoEm` sozinho não
  // serviria pra isso porque ele reflete a ÚLTIMA mudança do agendamento,
  // não especificamente a confirmação — um agendamento que já virou
  // CONCLUIDO, por exemplo, teria atualizadoEm apontando pra quando isso
  // aconteceu, não pra quando foi aceito.
  confirmadoEm  DateTime?

  // Marcado uma única vez, no exato momento em que o status vira CONCLUIDO
  // — mesmo padrão de confirmadoEm (TRANSICOES_PERMITIDAS em
  // PATCH /api/agendamentos/[id] só permite chegar em CONCLUIDO vindo de
  // CONFIRMADO, e nada transiciona a partir de CONCLUIDO, então isso nunca
  // é sobrescrito). Existe pro relatório de desempenho poder mostrar a
  // data marcada ao lado da data em que o corte foi de fato concluído.
  concluidoEm   DateTime?
  // Preenchido automaticamente (nunca editável pelo barbeiro) quando a
  // conclusão acontece num dia diferente do agendado (comparando em
  // America/Sao_Paulo) — ex.: "Concluído em 21/08/2026 — agendado para
  // 25/08/2026.". Continua null quando as datas batem.
  observacoes   String?

  criadoEm      DateTime          @default(now())
  atualizadoEm  DateTime          @updatedAt

  @@index([barbeariaId, data])
  // Usado por GET /api/agendamentos quando CLIENTE consulta o próprio
  // histórico (tela /meus-agendamentos) — sem filtro de data no caso comum,
  // então precisa do próprio índice (Postgres não indexa FK automaticamente).
  @@index([clienteId])
  // Trava de banco contra double-booking: garante que duas requisições
  // concorrentes não consigam criar dois agendamentos pro mesmo barbeiro no
  // mesmo instante, mesmo que ambas passem pela revalidação em memória.
  @@unique([barbeiroId, data])
}

// Um corte dentro de um agendamento (ex.: "cabelo" e "barba" no mesmo
// horário) — cada linha aqui congela nome/preço/duração do Servico no
// momento em que o agendamento foi criado, mesmo padrão de
// Agendamento.precoCobrado: se o dono editar o Servico depois (nome,
// preço), não muda retroativamente o que já foi agendado/exibido.
model AgendamentoServico {
  id            String      @id @default(cuid())
  agendamentoId String
  agendamento   Agendamento @relation(fields: [agendamentoId], references: [id], onDelete: Cascade)
  servicoId     String
  servico       Servico     @relation(fields: [servicoId], references: [id])

  nomeServico    String
  precoServico   Decimal @db.Decimal(10, 2)
  duracaoMinutos Int

  @@index([agendamentoId])
  // Não dá pra escolher o mesmo corte duas vezes no mesmo agendamento.
  @@unique([agendamentoId, servicoId])
}

// Acesso temporário e somente leitura de um usuário ADMIN (equipe da
// plataforma) a uma barbearia específica. Só o DONO concede (nunca o
// chefe, ver regra de negócio 14) — nada aqui é automático. A expiração
// (expiraEm) e a revogação manual (revogadoEm) são sempre conferidas na
// hora de cada consulta admin, nunca em cache (ver acessoAdminValido() em
// src/lib/exigirSessao.ts) — deixar vencer ou revogar tem efeito imediato.
// Linhas nunca são apagadas (só marcadas), pra o dono ter um histórico
// completo de quem já teve acesso.
model AcessoPlataforma {
  id          String    @id @default(cuid())
  usuarioId   String
  usuario     Usuario   @relation("AcessosComoAdmin", fields: [usuarioId], references: [id])
  barbeariaId String
  barbearia   Barbearia @relation(fields: [barbeariaId], references: [id])
  motivo      String?
  concedidoEm DateTime  @default(now())
  expiraEm    DateTime
  revogadoEm  DateTime?

  @@index([usuarioId])
  @@index([barbeariaId])
}
